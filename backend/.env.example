# Environment
ENV=development
DEBUG=True

# FastAPI Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# OpenAI API (Vision AI)
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_VISION_MODEL=gpt-4-vision-preview

# Metals-API (Edelmetallkurse)
METALS_API_KEY=your-metals-api-key-here
METALS_API_BASE_URL=https://metals-api.com/api

# PostgreSQL Database
DATABASE_URL=postgresql://user:password@localhost:5432/katz_db
DATABASE_ECHO=False
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=0

# Redis Cache
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_HOURS=12
REDIS_POOL_SIZE=10

# Supabase (Alternative zu PostgreSQL)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key-here

# Web Scraping
SCRAPER_TIMEOUT=30
SCRAPER_HEADLESS=True
SCRAPER_USER_AGENTS_ROTATION=True
SCRAPER_PROXY_ENABLED=False
SCRAPER_PROXY_URL=

# Security & CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]
ALLOWED_HOSTS=["localhost", "127.0.0.1"]
API_KEY_HEADER=X-API-Key
API_RATE_LIMIT_ENABLED=True
API_RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Cronjobs
CRONJOB_METALS_SYNC_INTERVAL=360  # 6 Stunden in Minuten
CRONJOB_SCRAPER_INTERVAL=120     # 2 Stunden in Minuten

# Feature Flags
FEATURE_VISION_AI_ENABLED=True
FEATURE_SCRAPER_ENABLED=True
FEATURE_VOICE_QUERY_ENABLED=True
